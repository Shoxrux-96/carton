{
  "expo": {
    "name": "Shovot Carton",
    "slug": "carton-erp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/logo.png",
    "plugins": [
      "expo-camera",
      "expo-image-picker",
      "expo-location",
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.shovotcarton.erp",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Davomatni tasdiqlash uchun Face ID ishlatiladi"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f97316",
        "foregroundImage": "./assets/logo.png"
      },
      "package": "uz.shovotcarton.erp",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "7b33629b-c2dc-4dae-9644-3a2da9514ff7"
      }
    },
    "owner": "shoxrux007"
  }
}
